# Baseten hosted Muse Spark Open: landmarks, quests and reading the signs in the photo. Server-side only.
# Never commit a real value. Never expose it to the browser bundle.
BASETEN_API_KEY=

# Meta Model API (SAM 3.1): the signs in the photo, boxed and outlined. Official name is MODEL_API_KEY.
MODEL_API_KEY=
META_API_KEY=
# Optional: "1" turns SAM 3.1 off; the sign check reads the plain photo.
SAM_DISABLED=

# Optional: Overpass API instances to try first (comma-separated, HTTPS only).
# Defaults, in order: https://overpass-api.de/api/interpreter, https://overpass.private.coffee/api/interpreter
OVERPASS_URLS=

# Optional: "off" leaves out the OpenFreeMap vector tiles (streets then come from Overpass).
STREET_TILES=

# Optional: "off" takes the places from OpenStreetMap only (no Overture Maps).
OVERTURE_PLACES=

# Optional per-instance daily call caps for the public demo.
DAILY_SPARK_CALL_CAP=
DAILY_STREET_CALL_CAP=
DAILY_SAM_CALL_CAP=
