# Baseten hosted Muse Spark Open (design plan from the photo). Server-side only.
# Never commit a real value. Never expose it to the browser bundle.
BASETEN_API_KEY=

# Meta Model API (SAM 3.1), not called yet. Official name is MODEL_API_KEY.
MODEL_API_KEY=
META_API_KEY=

# Optional: another Overpass API instance for building footprints.
# Default: https://overpass-api.de/api/interpreter
OVERPASS_URL=

# Optional per-instance daily call caps for the public demo.
DAILY_FOOTPRINT_CALL_CAP=
DAILY_SPARK_CALL_CAP=
